ARCHIVE_AUTH_SECRET=replace-with-a-long-random-secret
ARCHIVE_STORAGE_DIR=/absolute/path/to/persistent/archive-data
# Fresh installations only: set a unique password, log in once, then remove this setting.
# ARCHIVE_ACCOUNT_CODES='{"adam":"choose-a-long-unique-password"}'
# Only when your proxy overwrites this header and direct origin access is blocked:
# ARCHIVE_TRUSTED_IP_HEADER=x-real-ip
